  "layoutPolicy": {
    "runtime": "simulator/shared/layout-resize.js",
    "requiredForEverySimulator": true,
    "rules": [
      "Every simulator must load the shared layout-resize runtime.",
      "Every visible left or right side pane must be drag-resizable when viewport space allows.",
      "Resize hit targets must be easy to grab; users must not need pixel-perfect pointer placement.",
      "Pane sizes must be clamped so the primary workspace remains usable.",
      "User-adjusted pane sizes must persist per software and restore after reload, SIM_PACKAGE, SIM_SEEK, and responsive resize.",
      "Shared layout code provides resize/persistence mechanics only; each simulator continues to own its product-specific DOM and visual design.",
      "A simulator with no side pane is exempt from exposing a side-pane handle but still loads the shared runtime."
    ]
  }
}
