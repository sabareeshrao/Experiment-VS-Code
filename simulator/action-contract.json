{
  "version": 2,
  "policy": [
    "app.js orchestrates playback and must not implement product-specific UI.",
    "Each simulator owns its DOM, CSS, menus, dialogs and product behavior.",
    "Lessons depend on simulator actions, not arbitrary cross-simulator DOM manipulation.",
    "Every lesson action must be declared by its simulator before the lesson is merged.",
    "SIM_PACKAGE and SIM_SEEK must reconstruct a simulator deterministically from a clean load.",
    "Shared code may provide mechanics such as explanation positioning, highlighting and layout persistence, but not product visuals.",
    "Visible simulator side panes must be resizable and persistent through the shared layout runtime without sharing product-specific visuals."
  ],
  "protocol": {
    "parentToSimulator": [
      "SIM_PACKAGE",
      "SIM_SEEK",
      "SIM_EXPLAIN",
      "SIM_HIGHLIGHT",
      "SIM_HIGHLIGHT_CLEAR",
      "SIM_SETTING",
      "SIM_PING"
    ],
    "simulatorToParent": [
      "ENGINE_READY",
      "SIM_NAVIGATE"
    ],
    "requiredEngineMarkers": [
      "ENGINE_READY",
      "SIM_PACKAGE",
      "SIM_SEEK"
    ]
  },
  "simulators": {
    "intellij": {
      "directory": "intellij",
      "frameId": "ideFrame",
      "packageKey": "intellij_idea",
      "engineSource": "engine.js",
      "manifestKey": "intellij"
    },
    "vscode": {
      "directory": "vscode",
      "frameId": "vscodeFrame",
      "packageKey": "vscode",
      "engineSource": "engine.js",
      "manifestKey": "vscode"
    },
