      ],
      "toolWindows": [
        "Activity",
        "Development",
        "Automation Audit Log",
        "Release Details",
        "Dashboard Gadget"
      ],
      "dialogPresets": [
        "workflow",
        "automation"
      ]
    },
    "jenkins": {
      "registry": "JENKINS_CAPABILITIES",
      "features": [
        "job-context-menu",
        "build-context-menu",
        "stage-context-menu",
        "configuration-dialog",
        "parameter-dialog",
        "credential-dialog",
        "manage-panel",
        "plugin-panel",
        "node-panel"
      ],
      "menus": [
        "job",
        "build",
        "stage"
      ],
      "toolWindows": [
        "Manage Jenkins",
        "Credentials",
        "Plugins",
        "Nodes",
        "System Log",
        "Pipeline Syntax",
        "Build Queue"
      ],
      "dialogPresets": [
        "parameter",
        "credential"
      ]
    },
    "ssms": {
      "registry": "SSMS_CAPABILITIES",
      "features": [
        "context-menu",
        "nested-submenu",
        "menu-shortcuts",
        "menu-disabled-state",
        "menu-check-state",
        "adaptive-dialog",
        "property-pages",
        "radio-options",
        "checkbox-options",
        "dialog-tree",
        "tool-window",
        "tool-window-pin",
        "object-explorer-tree",
        "query-editor",
        "result-grid",
        "query-tabs",
        "split-tab-groups",
        "intellisense",
        "execution-plan",
        "client-statistics",
        "object-dependencies",
        "template-explorer",
        "solution-explorer",
        "registered-servers",
        "properties-window",
        "standard-reports",
        "connection-color"
      ],
      "menus": [
        "queryEditor",
        "table",
        "view",
        "procedure",
        "function",
        "database",
        "server",
        "resultGrid"
      ],
      "toolWindows": [
        "Template Explorer",
        "Solution Explorer",
        "Registered Servers",
        "Properties"
      ],
      "dialogPresets": [
        "Object Dependencies",
        "Server Properties",
        "Adaptive Dialog"
      ]
    },
    "powerbi": {
      "registry": "PBI_CAPABILITIES",
      "targetFidelity": 92,
      "features": [
        "modern-ribbon",
        "ribbon-search",
        "keytips",
        "report-view",
        "table-view",
        "model-view",
        "dax-query-view",
        "tmdl-view",
        "power-query-editor",
        "pane-switcher",
        "on-object-interaction",
        "model-explorer",
        "visual-formatting",
        "performance-analyzer",
        "publish"
      ],
      "actions": [
        "openDaxQueryView",
        "newDaxQuery",
        "typeDaxQuery",
        "runDaxQuery",
        "openTmdlView",
        "scriptTmdlObject",
        "typeTmdl",
        "previewTmdl",
        "applyTmdl",
        "openModelExplorer",
        "selectModelObject",
        "togglePane",
        "openPaneSwitcher",
        "openOnObjectBuild",
        "openFormatPane",
        "showVisualTable",
        "openSelectionPane",
        "openBookmarksPane",
        "toggleRibbonCollapsed",
        "showKeytips",
        "searchRibbon",
        "openContextMenu"
      ]
    }
  }
}
